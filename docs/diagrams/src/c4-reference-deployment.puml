@startuml c4-reference-deployment
!include ../vendor/C4_Deployment.puml
!include ../vendor/style.puml

title Reference deployment — managed backups and exportable confirmation proofs

Deployment_Node(device, "Participant device / business system", "Browser or gateway", "IoT adapter: live views, temporary telemetry buffer, bounded excursion retries") {
  Container(pwa, "Portal (PWA)", "Browser", "Capture, scoped queries and proof export")
  ContainerDb(local, "Participant records", "Local queue / existing system", "Signed events, proofs and retained abnormal windows; routine readings expire after final-event acceptance")
}
Deployment_Node(edge, "Amazon CloudFront", "Global edge", "Public delivery") {
  Container(cdn, "Snapshot cache", "CloudFront", "Versioned objects")
}
Deployment_Node(region, "AWS ap-southeast-2 — platform account", "Sydney", "Managed execution") {
  Container(app, "Traceability Application", "ECS Fargate", "Admission, query and export")
  Container(workers, "Projection Workers", "ECS Fargate", "Outbox-driven")
  Container(relayer, "Batch Builder & Relayer", "Isolated ECS task", "Wallet protected by KMS")
  ContainerDb(db, "Aurora PostgreSQL", "Writer + reader, Multi-AZ / PITR", "Events, receipts, registries, manifests/proofs and projections")
  Container(proxy, "RDS Proxy", "Managed", "Connection pooling")
  ContainerDb(s3, "Snapshot origin", "S3", "Versioned public objects")
  Container(kms, "Managed KMS", "Encryption / signing keys", "Protects storage and chain wallet")
}
Deployment_Node(dr, "AWS ap-southeast-4 — recovery copies", "Melbourne", "Same operator; separately administered backups are a future option") {
  ContainerDb(backup, "Encrypted backup copies", "Managed snapshot copies", "Retained operational data and proof records")
}
Deployment_Node(chainNet, "Ethereum mainnet", "Independent public network", "Immutable anchoring contract")
Rel(pwa, local, "Retains signed events / exported proofs")
Rel(pwa, app, "API", "HTTPS")
Rel(device, app, "IoT adapter: signed summaries / excursions", "HTTPS")
Rel(app, proxy, "Transactions and scoped reads", "SQL/TLS")
Rel(proxy, db, "Pooled connections", "TLS")
Rel(workers, db, "Projection / export intents", "SQL/TLS")
Rel(workers, s3, "Publish snapshots", "Object API")
Rel(cdn, s3, "Origin pull", "HTTPS")
Rel(pwa, cdn, "Trace page", "HTTPS")
Rel(relayer, db, "Leaves, manifests and proof records", "SQL/TLS")
Rel(relayer, chainNet, "Root submission / finality", "RPC")
Rel(relayer, kms, "Wallet signing", "Managed API")
Rel(db, kms, "Storage encryption", "Managed API")
Rel(db, backup, "Managed encrypted snapshot copy")
Rel(backup, db, "Restore with audited operator role")
Rel(local, chainNet, "Independently verify exported proofs", "Read-only")
@enduml
