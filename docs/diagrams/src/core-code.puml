@startuml core-code
!include ../vendor/style.puml
title Code view (major classes and interfaces) — Traceability Core

hide empty members
skinparam classAttributeIconSize 0

package "Admission and confirmation" {
  class CaptureSubmission {
    captureRecordId : UUID
    epcisEventId : URI
    profileId / profileVersion
    canonicalisationVersion
  }
  class CanonicalEvent {
    eventType
    eventTime / eventTimeZoneOffset
    bizStep / disposition
    bizLocation / readPoint
    sourceList / destinationList
    epcList / quantityList
  }
  class SignatureEnvelope {
    signerOrganisationId
    keyId
    algorithm
    payloadDigest
    signature
  }
  class ProfileVersion {
    profileId
    version
    granularity
    requiresFields
    consumerAllowlist
  }
  class AcceptanceReceipt {
    captureRecordId
    payloadDigest
    archiveAckDigest
    anchorWindow
    admittedAt
    admittedKeyId
    membershipStatusAtAdmission
    keyStatusAtAdmission
  }
}

package "Archive and anchoring" {
  class ArchiveEnvelope {
    envelopeVersion
    networkId
    ciphertextDigest
    wrappedDEK
    keyId / keyEpoch
  }
  class ArchiveAck {
    archiveObjectId
    envelopeDigest
    ciphertextDigest
    retentionPolicyId
    holderSignature
  }
  class MerkleLeaf {
    leafIndex
    payloadDigest
    signatureDigest
    ackDigest
  }
  class AnchorBatch {
    batchId
    windowStart / windowEnd
    root
    previousRoot
    txRef / finalisedAt
  }
}

package "Evidence and query" {
  class EvidenceEdge {
    fromObjectId / toObjectId
    edgeType
    sourceEventId
    publisher
    effectiveInterval
    confirmationStatus
  }
  class EdgeGroup {
    fromObjectId / toObjectId
    edgeType
    edges
  }
  class EdgeQuery {
    subjectRef
    edgeTypes
    timeWindow
    watermark
  }
  interface QueryPort {
    edges(EdgeQuery) : EdgeGroup[]
    traverse(EdgeQuery, depth) : EdgeGroup[]
  }
  class ProtectedResourceRef {
    resourceId
    ownerOrganisationId
    plaintextCommitment
    storageMode
    availabilityStatus
  }
}

package "Organisation identity (mutable registries, outside canonical events)" {
  class Organisation {
    organisationId : UUID
    membershipStatus
  }
  class UserMembership {
    externalSubjectId
    organisationId
    role
  }
  class OrganisationSigningKey {
    keyId : UUID
    organisationId
    publicKey
    algorithm
    registeredAt / revokedAt
    status
  }
  class IdentityAuditRecord {
    changeId : UUID
    actorRef / organisationId
    changeType / changedAt
  }
}

package "Enumerations" {
  enum ConfirmationStatus {
    SUBMITTED
    VALIDATED
    PENDING_ARCHIVE
    PENDING_ANCHOR
    FINALISED
    CONFIRMED
    REJECTED
  }
  enum EdgeType {
    TRANSFORMATION
    AGGREGATION
    HANDOVER
    CORRECTION
  }
}

CaptureSubmission --> SignatureEnvelope : carries
CaptureSubmission --> ProtectedResourceRef : references
CaptureSubmission --> CanonicalEvent : materialises
CanonicalEvent ..> ProfileVersion : validated against
CanonicalEvent --> ArchiveEnvelope : encrypted as
ArchiveEnvelope --> ArchiveAck : acknowledged by
CanonicalEvent --> MerkleLeaf : committed as
MerkleLeaf --> AnchorBatch : batched into
CanonicalEvent --> EvidenceEdge : derives
EvidenceEdge --> EdgeGroup : grouped into
QueryPort ..> EdgeQuery : accepts
QueryPort ..> EdgeGroup : returns
AcceptanceReceipt ..> ArchiveAck : binds digest
AcceptanceReceipt ..> CanonicalEvent : promises
CanonicalEvent --> ConfirmationStatus
EvidenceEdge --> EdgeType

Organisation "1" <-- "0..*" UserMembership : belongs to
Organisation "1" <-- "0..*" OrganisationSigningKey : authorised for
Organisation "1" <-- "0..*" IdentityAuditRecord : records changes
SignatureEnvelope ..> OrganisationSigningKey : identifies key
AcceptanceReceipt ..> OrganisationSigningKey : retains key and admission status

@enduml