@startuml core-component
!include ../vendor/C4_Component.puml
!include ../vendor/style.puml

title Component view — Traceability Core (inside the modular monolith)

Container_Boundary(core, "Traceability Core") {

  Component(capture, "Capture API", "Inbound REST endpoint", "Accepts EPCIS event, SignatureEnvelope, captureRecordId, profile reference")
  Component(idem, "Idempotency & Outbox Coordinator", "Transactional outbox", "Deduplicates by captureRecordId and digest, enqueues external side effects")
  Component(canon, "Canonicalisation & Profile Validator", "Deterministic digest", "Schema, profile version, core field floor, conformance check")
  Component(sig, "Signature & Membership Validator", "EventSignatureVerifier", "Verifies signature, approved membership and current key status at receipt")
  Component(sm, "Submission State Machine", "Lifecycle", "SUBMITTED to CONFIRMED, retry and rejection states")
  Component(orch, "Anchor Confirmation Coordinator", "Gate keeper", "Coordinates durable event and receipt storage with anchor intent; confirms only after chain finality")
  Component(graph, "Evidence Graph Builder", "edgeDerivationVersion", "Edges from EPCIS semantics only; derivation is versioned and replayable for audit")
  ComponentDb(store, "Event Store", "Append-only tables in PostgreSQL", "Accepted signed events, receipts, confirmation metadata, edges and QueryStore")
  Component(query, "QueryPort", "Single read entrance", "Enforces scope, non-collapsing and watermark; returns edge groups with provenance")
}

Component_Ext(modules, "Semantic Modules (same process)", "Handover, Recall, Compliance, Consumer, Insights")
Component_Ext(idgov, "Organisation & Key Registry", "Approved members, user role mappings, key history and identity change audit")
Component_Ext(profiles, "Product Profile Registry", "Governance-published, immutable versions")

Rel(capture, idem, "Check and register")
Rel(capture, canon, "Raw event")
Rel(canon, sig, "Canonical payload + digest")
Rel(sig, sm, "Validated submission")
Rel(sm, orch, "Validated event")
Rel(orch, store, "Atomic event, receipt and anchor intent; later confirmation metadata")
Rel(graph, store, "Read canonical events, write edges")
Rel_Down(query, store, "Scoped read")
Rel(modules, query, "edges(), traverse()")
Rel(sig, idgov, "Membership, key state")
Rel(canon, profiles, "Profile, floor, conformance")

SHOW_LEGEND()
@enduml