@startuml core-container
!include ../vendor/C4_Container.puml
!include ../vendor/style.puml

title Container view — Agricultural Supply Chain Tracker (first release)

Person(participant, "Participant staff", "Farmer, packer, distributor, retailer, lab")
Person(regulator, "Regulator officer", "NSW food authority investigator")
Person(consumer, "Consumer", "Scans a product QR code")

System_Ext(idp, "External Identity Provider", "Human authentication")
System_Ext(erp, "Participant business systems", "ERP / WMS / TMS / IoT gateway")

System_Boundary(system, "Agricultural Supply Chain Tracker") {

  Container_Boundary(platform, "Platform control domain") {
    Container(portal, "Participant & Regulator Portal", "PWA in browser", "Capture forms, lineage and recall views, evidence requests, exports")
    Container(app, "Traceability Application", "Modular monolith (Core + 6 modules)", "Admission validation, confirmation gate, evidence graph, single QueryPort")
    Container(workers, "Ingestion & Projection Workers", "Outbox-driven workers", "Idempotent retry, projection rebuild, export, retention, advisory intake")
    Container(relayer, "Batch Builder & Relayer", "Isolated worker with chain wallet", "Merkle batching, root submission, inclusion proofs")
    ContainerDb(db, "Operational PostgreSQL", "Managed PostgreSQL", "Submission state, current registries, outbox, QueryStore, projections")
    Container(cdn, "Public Snapshot Delivery", "Object storage + CDN", "Versioned PUBLIC consumer snapshots")
  }

  Container(analytics, "Analytics Workspace", "Regulator-operated runtime, own account", "Signed RuleVersions, screening, private findings, signed advisories")
}

Container_Ext(archive, "External Archive", "WORM, outside platform control domain", "Encrypted canonical payload; signs ArchiveAck")
Container_Ext(kms, "Consortium KMS", "Trustee-controlled account", "Consortium KEK; wrap/unwrap only")
System_Ext(chain, "Public Blockchain", "Merkle root only")

Rel_Down(participant, portal, "Captures, queries")
Rel_Down(regulator, portal, "Investigates, exports")
Rel_Down(consumer, cdn, "Reads trace page")
Rel_Down(erp, app, "EPCIS event")
Rel_Right(portal, idp, "OIDC")
Rel_Down(portal, app, "API")
Rel_Down(app, db, "State, outbox, QueryStore")
Rel_Down(workers, cdn, "Publishes snapshots")
Rel_Left(workers, kms, "DEK wrap")
Rel_Left(workers, archive, "Envelope, Ack")
Rel_Down(relayer, archive, "Batch manifest")
Rel_Down(relayer, db, "Leaves, intents")
Rel_Right(relayer, chain, "Merkle root")
Rel_Right(app, analytics, "DatasetSnapshot (signed)")
Rel_Left(analytics, workers, "Signed advisories, rule manifests")
Rel_Up(workers, db, "Outbox poll")

SHOW_LEGEND()
@enduml