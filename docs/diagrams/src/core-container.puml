@startuml core-container
!include ../vendor/C4_Container.puml
!include ../vendor/style.puml

title Container view — Agricultural Supply Chain Tracker (first release)

Person(participant, "Participant staff", "Farmer, packer, distributor, retailer, lab")
Person(regulator, "Regulator officer", "NSW food authority investigator")
Person(consumer, "Consumer", "Scans a product QR code")

System_Ext(devices, "IoT devices", "Participant-managed sensors")
System_Ext(idp, "External Identity Provider", "Human authentication")
System_Ext(erp, "Participant business systems", "ERP / WMS / TMS")

System_Boundary(system, "Agricultural Supply Chain Tracker") {

  Container_Boundary(participantDomain, "Participant-operated gateway") {
    Container(iot, "IoT Adapter", "Delivered gateway software", "Real-time collection, authorised local views, temporary buffer, signed summaries and excursions")
  }

  Container_Boundary(platform, "Platform control domain") {
    Container(portal, "Participant & Regulator Portal", "PWA in browser", "Capture forms, lineage and recall views, scoped evidence exports")
    Container(app, "Traceability Application", "Modular monolith (Core + 5 modules)", "Admission validation, confirmation gate, evidence graph, single QueryPort, scoped insights")
    Container(workers, "Ingestion & Projection Workers", "Outbox-driven workers", "Idempotent retry, projection rebuild, export, retention")
    Container(relayer, "Batch Builder & Relayer", "Isolated worker with chain wallet", "Merkle batching, root submission, inclusion proofs")
    ContainerDb(db, "Operational PostgreSQL", "Managed PostgreSQL", "Signed events, receipts, registries, outbox, manifests/proofs and query projections")
    Container(cdn, "Public Snapshot Delivery", "Object storage + CDN", "Versioned PUBLIC consumer snapshots")
    ContainerDb(backup, "Managed Backup Storage", "Encrypted backups / PITR", "Operational records and verification material; not a confirmation gate")
  }

}

System_Ext(chain, "Public Blockchain", "Merkle root only")

Rel_Down(participant, portal, "Captures, queries")
Rel_Down(regulator, portal, "Investigates, exports")
Rel_Down(consumer, cdn, "Reads trace page")
Rel_Down(erp, app, "EPCIS event")
Rel(devices, iot, "Real-time readings")
Rel(participant, iot, "Views current observations (authorised logistics staff)")
Rel(iot, app, "Signed summaries and excursions", "HTTPS")
Rel_Right(portal, idp, "OIDC")
Rel_Down(portal, app, "API")
Rel_Down(app, db, "Atomic event, receipt and outbox; scoped reads")
Rel(db, backup, "Managed backup", "Encrypted")
Rel_Down(workers, cdn, "Publishes snapshots")
Rel_Down(relayer, db, "Leaves, intents")
Rel_Right(relayer, chain, "Merkle root")
Rel_Up(workers, db, "Outbox poll")

SHOW_LEGEND()
@enduml