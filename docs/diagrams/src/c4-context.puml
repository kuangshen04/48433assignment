@startuml c4-context
!include ../vendor/C4_Context.puml
!include ../vendor/style.puml

title System context — Agricultural Supply Chain Tracker
LAYOUT_TOP_DOWN()

Person(participantUser, "Participant staff", "Farm to retail")
Person(consumer, "Consumer", "Scans a QR code")
Person(regulatorOfficer, "Regulator officer", "Food authority")
Person(governance, "Consortium governance", "Approves members; oversees key changes")

System_Boundary(scope, "Agricultural Supply Chain Tracker") {
  System(iot, "IoT Adapter", "Delivered software on participant gateways; real-time collection, temporary local views and signed event submission")
  System(tracker, "Traceability Core", "Shared traceability records, verifiable history, scoped investigations and built-in supply-chain analytics")
}

System_Ext(devices, "IoT devices and gateways", "Sensors, scales, scanners")
System_Ext(participantSystems, "Participant business systems", "ERP / WMS / TMS")
System_Ext(chain, "Public blockchain", "Merkle roots")
System_Ext(idp, "Identity provider", "Authentication")
System_Ext(regSystems, "Regulator systems", "Existing case management")

Rel_Down(participantSystems, tracker, "Signed EPCIS events; local copies")
Rel_Right(devices, iot, "Real-time readings")
Rel_Down(iot, tracker, "Signed EPCIS summaries and excursion events")
Rel(participantUser, iot, "Views current observations (authorised logistics staff)")
Rel_Down(participantUser, tracker, "Captures events, traces lots, views product-line and cold-chain insights, exports proofs")
Rel_Down(consumer, tracker, "Reads trace page")
Rel_Down(regulatorOfficer, tracker, "Investigates, exports")
Rel_Down(governance, tracker, "Approved members and key changes")
Rel_Down(tracker, chain, "Merkle roots")
Rel_Down(tracker, idp, "OIDC")
Rel_Right(tracker, regSystems, "Scoped evidence exports")
SHOW_LEGEND()
@enduml
