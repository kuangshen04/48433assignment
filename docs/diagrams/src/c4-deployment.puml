@startuml c4-deployment
!include ../vendor/C4_Deployment.puml
!include ../vendor/style.puml

title Deployment view — platform recovery and independent verification

Deployment_Node(device, "Participant device / business system", "Browser or gateway", "Intermittent connectivity; IoT adapter: live views, temporary telemetry buffer, bounded excursion retries") {
  Container(pwa, "Portal (PWA)", "Browser", "Capture, query and proof export")
  ContainerDb(local, "Participant records", "Local storage / existing system", "Signed submissions, proofs and retained abnormal windows; routine readings expire after final-event acceptance")
}
Deployment_Node(edge, "CDN edge", "Global PoPs", "Static snapshots") {
  Container(cdn, "Snapshot cache", "CDN", "Versioned public objects")
}
Deployment_Node(region, "Australian region — platform account", "Managed services", "Platform-operated") {
  Container(app, "Traceability Application", "Containers", "Core and modules")
  Container(workers, "Projection Workers", "Containers", "Outbox-driven projections and exports")
  Container(relayer, "Batch Builder & Relayer", "Isolated container", "Only chain wallet")
  ContainerDb(db, "Operational PostgreSQL", "Managed multi-AZ / PITR", "Signed events, receipts, registries, proof and query records")
  ContainerDb(snapshots, "Snapshot origin", "Object storage", "Public projections")
  Container(kms, "Managed KMS", "Cloud-managed", "Storage encryption and wallet protection")
}
Deployment_Node(dr, "Australian recovery region", "Managed backup storage", "Conventional restore; no independent rebuild guarantee") {
  ContainerDb(backup, "Encrypted backup copies", "Database snapshots / backup retention", "Operational data and verification material")
}
Deployment_Node(chainNet, "Public blockchain", "Independent network", "Finalised commitments; no business payload")
Rel(pwa, local, "Retain submissions and proofs")
Rel(pwa, app, "Capture, query, export", "HTTPS")
Rel(device, app, "IoT adapter: signed summaries / excursions", "HTTPS")
Rel(app, db, "Atomic event, receipt and anchor intent", "SQL/TLS")
Rel(workers, db, "Projection / export work", "SQL/TLS")
Rel(workers, snapshots, "Publish", "Object API")
Rel(cdn, snapshots, "Origin pull", "HTTPS")
Rel(pwa, cdn, "Trace page", "HTTPS")
Rel(relayer, db, "Leaves, manifests and proofs", "SQL/TLS")
Rel(relayer, chainNet, "Root submission and finality", "RPC")
Rel(relayer, kms, "Wallet signing", "Managed API")
Rel(db, kms, "Storage encryption", "Managed API")
Rel(db, backup, "Managed encrypted backup copy")
Rel(backup, db, "Restore after failure")
Rel(local, chainNet, "Independently verify exported commitments", "Read-only")
SHOW_LEGEND()
@enduml
