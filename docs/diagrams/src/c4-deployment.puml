@startuml c4-deployment
!include ../vendor/C4_Deployment.puml

title Deployment view — reference configuration

Deployment_Node(device, "Participant device", "Browser, app or gateway", "Intermittent connectivity") {
  Container(pwa, "Portal (PWA)", "Browser", "Capture, query, offline queue")
}

Deployment_Node(edge, "CDN edge", "Global PoPs", "Static snapshots") {
  Container(cdn, "Snapshot cache", "CDN", "Versioned objects")
}

Deployment_Node(region, "Australian region — platform account", "One cloud region", "Managed services only") {
  Container(app, "Traceability Application", "Containers", "Core and modules")
  Container(workers, "Ingestion & Projection Workers", "Containers", "Outbox-driven")
  Container(relayer, "Batch Builder & Relayer", "Isolated worker", "Only chain wallet")
  ContainerDb(db, "Operational PostgreSQL", "Managed, multi-AZ", "State, outbox, QueryStore")
}

Deployment_Node(trustee, "Australian regions — trustee account", "Separate account", "Consortium-controlled") {
  ContainerDb(archive, "External archive", "WORM storage", "Payload; signs ArchiveAck")
  Container(kms, "Consortium KMS", "Managed KMS, HSM", "Wraps event DEKs")
  Container(recovery, "Recovery identity", "Separate IAM", "Restores without platform")
}

Deployment_Node(regacct, "Regulator account", "Separate account", "Regulator-operated") {
  Container(workspace, "Analytics Workspace", "Containers", "Rules, screening, advisories")
  ContainerDb(rules, "Rule registry", "Regulator store", "Rule bodies, versions")
  ContainerDb(findings, "Finding store", "Regulator store", "Findings, advisories")
}

Deployment_Node(chainNet, "Public blockchain", "External utility", "No validator operation")

Rel_Down(pwa, app, "API", "HTTPS")
Rel_Down(app, db, "Read/write", "SQL/TLS")
Rel_Down(app, workers, "Same image, worker role")
Rel_Down(workers, db, "Polls outbox", "SQL/TLS")
Rel_Left(app, kms, "Wrap/unwrap DEK", "mTLS")
Rel_Left(workers, archive, "Envelope, Ack", "HTTPS")
Rel(workers, cdn, "Publish", "Object API")
Rel_Down(relayer, db, "Leaves, intents", "SQL/TLS")
Rel(relayer, chainNet, "Merkle root", "tx")
Rel_Right(app, workspace, "DatasetSnapshot", "Signed")
Rel_Up(pwa, cdn, "Trace page", "HTTPS")
Rel(cdn, app, "Origin pull", "HTTPS")

SHOW_LEGEND()
@enduml