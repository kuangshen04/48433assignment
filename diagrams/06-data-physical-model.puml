@startuml Traceability_Physical_Data_Model

title Week 10 Physical PostgreSQL Model - Core Tables

hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 45

entity "registry.organisation" as organisation {
  * organisation_id : uuid <<PK>>
  --
  organisation_code : varchar(128) <<UK>>
  legal_name : varchar(255)
  status : varchar(16)
  region_code : varchar(32)
  version : bigint
}

entity "registry.identity" as identity {
  * identity_id : uuid <<PK>>
  --
  organisation_id : uuid <<FK>>
  subject_ref : varchar(255)
  identity_type : varchar(16)
  status : varchar(16)
}

entity "registry.signing_key" as signing_key {
  * key_id : uuid <<PK>>
  --
  identity_id : uuid <<FK>>
  algorithm : varchar(32)
  key_fingerprint : char(64) <<UK>>
  valid_from : timestamptz
  valid_until : timestamptz
  revoked_at : timestamptz
}

entity "registry.profile_version" as profile_version {
  * profile_version_id : uuid <<PK>>
  --
  profile_id : uuid <<FK>>
  version_label : varchar(64)
  schema_document : jsonb
  validation_rules : jsonb
}

entity "events.event_submission" as event_submission {
  * submission_id : uuid <<PK>>
  --
  event_id : uuid <<UK>>
  payload_commitment : char(64)
  status : varchar(24)
  received_at : timestamptz
  retry_count : integer
}

entity "events.trace_event" as trace_event {
  * event_id : uuid <<PK>>
  --
  submission_id : uuid <<FK, UK>>
  event_type : varchar(32)
  profile_version_id : uuid <<FK>>
  publisher_organisation_id : uuid <<FK>>
  signing_identity_id : uuid <<FK>>
  signing_key_id : uuid <<FK>>
  event_time : timestamptz
  timezone_offset_minutes : smallint
  record_time : timestamptz
  biz_step : varchar(255)
  disposition : varchar(255)
  visibility_policy_id : uuid <<FK>>
  retention_policy_id : uuid <<FK>>
  payload_commitment : char(64)
  signature : bytea
  canonical_event : jsonb
}

entity "events.traceable_object" as traceable_object {
  * object_id : varchar(512) <<PK>>
  --
  object_type : varchar(32)
  profile_version_id : uuid <<FK>>
  product_class_ref : varchar(512)
}

entity "events.event_object" as event_object {
  * event_id : uuid <<PK, FK>>
  * object_id : varchar(512) <<PK, FK>>
  * object_role : varchar(16) <<PK>>
  * ordinal : smallint <<PK>>
  --
  quantity : numeric(20,6)
  uom : varchar(12)
}

entity "events.external_artifact" as external_artifact {
  * artifact_id : uuid <<PK>>
  --
  owner_organisation_id : uuid <<FK>>
  artifact_type : varchar(32)
  provider_type : varchar(32)
  opaque_locator : varchar(1024)
  content_commitment : char(64)
  commitment_scheme : varchar(64)
  access_policy_id : uuid <<FK>>
  retention_policy_id : uuid <<FK>>
  availability_status : varchar(16)
}

entity "events.ledger_commitment" as ledger_commitment {
  * event_id : uuid <<PK, FK>>
  --
  ledger_network_id : varchar(128)
  ledger_transaction_id : varchar(256) <<UK>>
  ledger_sequence : bigint
  committed_at : timestamptz
  payload_commitment : char(64)
  receipt : jsonb
}

entity "events.outbox_message" as outbox_message {
  * message_id : uuid <<PK>>
  --
  aggregate_id : varchar(512)
  message_type : varchar(128)
  payload : jsonb
  created_at : timestamptz
  published_at : timestamptz
  retry_count : integer
}

entity "projection.trace_edge" as trace_edge {
  * edge_id : uuid <<PK>>
  --
  edge_type : varchar(16)
  from_object_id : varchar(512)
  to_object_id : varchar(512)
  source_event_id : uuid
  valid_from : timestamptz
  valid_until : timestamptz
  state : varchar(16)
  quantity : numeric(20,6)
  uom : varchar(12)
}

entity "projection.handover" as handover {
  * handover_id : uuid <<PK>>
  --
  object_id : varchar(512)
  from_organisation_id : uuid
  to_organisation_id : uuid
  shipping_event_id : uuid
  receiving_event_id : uuid
  handover_state : varchar(20)
  shipped_quantity : numeric(20,6)
  received_quantity : numeric(20,6)
  projection_sequence : bigint
}

organisation ||--o{ identity
identity ||--o{ signing_key
organisation ||--o{ trace_event
identity ||--o{ trace_event
signing_key ||--o{ trace_event
profile_version ||--o{ trace_event
event_submission ||--o| trace_event
trace_event ||--|{ event_object
traceable_object ||--o{ event_object
organisation ||--o{ external_artifact
trace_event ||--o| ledger_commitment
trace_event ..> trace_edge : projects
trace_event ..> handover : projects
trace_event ..> outbox_message : publishes

note bottom of trace_event
  UPDATE and DELETE are rejected.
  Corrections append new events.
end note

note bottom of trace_edge
  Indexes:
  (from_object_id, edge_type, state)
  (to_object_id, edge_type, state)
end note

@enduml
