@startuml Traceability_Logical_Projection_Model

title Week 10 Logical Projection Model - Rebuildable PostgreSQL Views

hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 60

package "events schema - source" {
  entity trace_event
  entity traceable_object
  entity event_object
  entity outbox_message
}

package "projection schema - rebuildable" {
  entity trace_edge {
    CONTAINS
    DERIVED_FROM
  }
  entity handover {
    shipping + receiving
    derived state
  }
  entity current_object_state
  entity consumer_projection
  entity provenance_completeness
  entity risk_assessment
}

package "operations schema" {
  entity projection_checkpoint
  entity access_audit
}

trace_event ||--|{ event_object
traceable_object ||--o{ event_object
trace_event ..down.> trace_edge : projects lineage
trace_event ..down.> handover : correlates assertions
trace_event ..down.> current_object_state : folds history
trace_event ..down.> consumer_projection : filters public view
trace_event ..down.> provenance_completeness : evaluates gaps
trace_event ..down.> risk_assessment : supplies features

outbox_message ..down.> projection_checkpoint : advances replay
projection_checkpoint ..> trace_edge : checkpoints
projection_checkpoint ..> handover : checkpoints
access_audit ..> consumer_projection : records access

note bottom of trace_edge
  Indexed adjacency list traversed
  by PostgreSQL recursive CTEs.
end note

note bottom of projection_checkpoint
  Projection tables can be truncated
  and deterministically rebuilt.
end note

@enduml
