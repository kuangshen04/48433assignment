@startuml Agricultural_Supply_Chain_Traceability_Containers
!include <C4/C4_Container>

title C4 Level 2 Container - Agricultural Supply Chain Traceability Network

LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65

Person(participant, "Supply-chain Participant", "Uses a PWA or an existing enterprise system.")
Person(consumer, "Consumer", "Views public provenance.")
Person(auditor, "Auditor or Regulator", "Verifies authorised history and evidence.")
Person(admin, "Consortium Administrator", "Manages membership, profiles and governance.")

System_Ext(enterpriseSystems, "Enterprise Operational Systems", "ERP, WMS, TMS, MES, farm-management and POS systems.")
System_Ext(iotPlatform, "External IoT Platform", "Raw telemetry, device operations and signed sensor evidence.")
System_Ext(labSystems, "Laboratory and Certification Systems", "Test and certificate evidence sources.")

System_Boundary(traceNetwork, "Agricultural Supply Chain Traceability Network") {
  Container(participantPwa, "Participant PWA", "Offline-capable browser PWA", "Captures events, queues offline submissions, confirms handovers and displays authorised traces.")
  Container(consumerPortal, "Consumer Portal", "Public web application", "Serves a minimised provenance, public evidence and affected or recalled status.")
  Container(auditPortal, "Governance and Audit Portal", "Restricted web application", "Manages membership and profiles; supports verification, investigation and audit export.")

  Container(apiGateway, "API Gateway", "Managed API gateway and WAF", "Terminates TLS, authenticates callers, rate-limits, versions and routes external requests.")
  Container(traceApp, "Traceability Application", "Modular backend application", "Contains integration, commit, query, governance, identity, profile, policy, handover, lineage, evidence and correction modules. Uses logical CQRS without requiring separate command and query deployments.")
  Container(projectionWorker, "Projection Worker", "Background executable", "Consumes committed events and builds replayable handover, lineage, impact and audience read models.")
  Container(riskService, "Risk Analysis Service [Optional]", "Asynchronous ML service", "Produces advisory cold-chain anomaly or spoilage-risk assessments without changing source facts.")

  ContainerDb(metadataDb, "Metadata Database", "Managed relational database", "Stores organisations, identities, sites, devices, profiles, policies and application configuration.")
  ContainerDb(eventStore, "Encrypted Event Store", "Managed durable event database", "Stores canonical event payloads, submission states, idempotency records and transactional outbox data.")
  ContainerDb(readStore, "Trace Read Store", "Graph, search and projection store", "Stores provenance edges, derived state, trace indexes, audience projections and impact-query data.")
  Container(messageBroker, "Message Broker", "Managed event broker", "Carries committed-event, projection-completed and advisory-risk messages with retry and replay support.")
  Container(ledger, "Consortium Ledger Network", "Multi-organisation permissioned ledger", "Stores event commitments, approved shared facts, signatures, lineage references and correction links under independent governance.")
}

Lay_R(participantPwa, consumerPortal)
Lay_R(consumerPortal, auditPortal)
Lay_D(consumerPortal, apiGateway)
Lay_D(apiGateway, traceApp)
Lay_R(metadataDb, eventStore)
Lay_R(eventStore, ledger)
Lay_R(ledger, messageBroker)
Lay_D(messageBroker, projectionWorker)
Lay_R(projectionWorker, riskService)
Lay_D(projectionWorker, readStore)

Rel(participant, participantPwa, "Captures events and queries trace", "Browser/HTTPS")
Rel(consumer, consumerPortal, "Scans and views public trace", "Browser/HTTPS")
Rel(auditor, auditPortal, "Verifies events and exports evidence", "Browser/HTTPS")
Rel(admin, auditPortal, "Manages membership, profiles and policy", "Browser/HTTPS")

Rel(participantPwa, apiGateway, "Submits events; queries trace", "HTTPS/JSON")
Rel(consumerPortal, apiGateway, "Requests public projection", "HTTPS/JSON")
Rel(auditPortal, apiGateway, "Admin and audit requests", "HTTPS/JSON")
Rel(enterpriseSystems, apiGateway, "Publishes events; receives receipts", "EPCIS/REST")
Rel(iotPlatform, apiGateway, "Publishes sensor evidence", "HTTPS/JSON")
Rel(labSystems, apiGateway, "Publishes compliance evidence", "HTTPS/JSON")

Rel(apiGateway, traceApp, "Routes integration, commit, query and governance requests", "Internal API")
Rel(traceApp, metadataDb, "Reads and writes identity, profile and policy metadata", "SQL")
Rel(traceApp, eventStore, "Stores payload, state, idempotency and outbox atomically", "Database protocol")
Rel(traceApp, readStore, "Reads authorised provenance and audience projections", "Query protocol")
Rel(traceApp, ledger, "Commits envelopes and verifies receipts", "Ledger SDK/API")
Rel(traceApp, messageBroker, "Publishes EventCommitted via outbox", "Async event")

Rel(messageBroker, projectionWorker, "Delivers committed events and replay requests", "Async event")
Rel(projectionWorker, eventStore, "Reads committed canonical payloads", "Database protocol")
Rel(projectionWorker, readStore, "Builds trace and audience projections", "Database protocol")
Rel(projectionWorker, messageBroker, "Publishes ProjectionCompleted", "Async event")

Rel(riskService, readStore, "Reads analytical projection", "Query protocol")
Rel(riskService, messageBroker, "Publishes advisory RiskAssessmentGenerated", "Async event")

SHOW_LEGEND()
@enduml
