@startuml Traceability_Application_Components
!include <C4/C4_Component>

title C4 Level 3 Component - Traceability Application Module Dependencies

LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55

Container_Ext(apiGateway, "API Gateway", "Routes authenticated participant, integration, query and governance requests.")
ContainerDb_Ext(traceDb, "Traceability PostgreSQL Database", "Registry, event, operations and rebuildable projection schemas in one managed PostgreSQL database.")
Container_Ext(ledger, "Consortium Ledger Network", "Shared event commitments, signatures and lineage references.")
Container_Ext(messageBroker, "Message Broker", "Committed-event and application messages.")
System_Ext(artifactStore, "Participant-controlled Artifact Stores", "External sensitive documents, private extensions and raw evidence addressed by opaque references.")

Container_Boundary(traceAppBoundary, "Traceability Application") {
  Boundary(interfaceBoundary, "Interface Modules") {
    Component(participantApi, "Participant API", "Inbound module", "Exposes participant event, handover and trace operations.")
    Component(integrationApi, "Enterprise and IoT Integration API", "Inbound module", "Accepts EPCIS, enterprise, sensor and evidence inputs and maps them to application commands.")
    Component(queryApi, "Trace Query API", "Inbound module", "Exposes consumer, participant and auditor trace queries.")
    Component(governanceApi, "Governance API", "Inbound module", "Exposes organisation, identity, profile and policy administration.")
  }

  Boundary(applicationBoundary, "Application Modules") {
    Component(eventCommit, "Event Commit Module", "Application module", "Orchestrates validation strategies, idempotency, domain handlers and Received → Validated → PayloadStored → PendingLedger → Committed state transitions.")
    Component(traceQuery, "Trace Query Module", "Application module", "Orchestrates disclosure, graph traversal, integrity verification, impact analysis and audience view construction.")
    Component(governance, "Governance Module", "Application module", "Coordinates membership, key status, product-profile lifecycle and governance-policy changes.")
  }

  Boundary(domainBoundary, "Domain Modules") {
    Component(eventCore, "Event Core", "Stable domain kernel", "Defines TraceEvent, TraceableObject, Quantity, EventStatus and HANDOVER, CONTAINS and DERIVED_FROM edge types.")
    Component(handoverModule, "Handover Module", "Domain module", "Defines repeatable shipping and receiving assertions and derived handover states.")
    Component(lineageModule, "Lineage Module", "Domain module", "Defines aggregation, disaggregation, split, merge, transformation, quantity and loss invariants.")
    Component(evidenceModule, "Evidence Module", "Domain module", "Defines IoT, laboratory and certificate evidence references, signatures and availability semantics.")
    Component(correctionModule, "Correction Module", "Domain module", "Defines ErrorDeclaration, corrective-event linkage and effective interpretation without history deletion.")
    Component(profileModule, "Product Profile Module", "Domain module", "Defines versioned product constraints, required evidence, units, business steps and compatibility rules.")
    Component(accessPolicy, "Access Policy Module", "Domain module", "Provides command authorisation and query disclosure interfaces with different policy semantics.")
    Component(provenanceModule, "Provenance Module", "Domain module", "Defines upstream lineage, downstream impact, completeness and audience-independent trace semantics.")
  }

  Boundary(portBoundary, "Application Ports") {
    Component(identityMetadataPort, "Identity and Metadata Port", "Port interface", "Organisation, identity, key, profile and policy persistence abstraction.")
    Component(eventRepositoryPort, "Event Repository Port", "Port interface", "Append-only payload, state and idempotency persistence abstraction.")
    Component(readModelPort, "Read Model Port", "Port interface", "Provenance graph and audience projection query abstraction.")
    Component(ledgerPort, "Ledger Port", "Port interface", "Commitment submission and verification abstraction.")
    Component(eventPublisherPort, "Event Publisher Port", "Port interface", "Durable application-event publication abstraction.")
    Component(artifactReferencePort, "Artifact Reference Port", "Port interface", "External artifact registration, authorised resolution and commitment-verification abstraction.")
  }

  Boundary(adapterBoundary, "Infrastructure Adapters") {
    Component(postgresAdapter, "PostgreSQL Adapter", "Outbound adapter", "Implements logically separate identity, event-repository and read-model ports using one PostgreSQL database.")
    Component(ledgerAdapter, "Consortium Ledger Adapter", "Outbound adapter", "Implements deterministic commitment, receipt mapping, verification and retry.")
    Component(outboxAdapter, "Transactional Outbox Publisher", "Outbound adapter", "Implements reliable EventCommitted publication after ledger confirmation.")
    Component(artifactAdapter, "Artifact Provider Adapter", "Outbound adapter", "Implements provider-neutral artifact references, authorised access and nonce-based commitment verification.")
  }
}

Lay_R(governanceApi, integrationApi)
Lay_R(integrationApi, participantApi)
Lay_R(participantApi, queryApi)

Lay_D(governanceApi, governance)
Lay_D(participantApi, eventCommit)
Lay_R(governance, eventCommit)
Lay_R(eventCommit, traceQuery)

Lay_D(eventCommit, lineageModule)
Lay_R(profileModule, handoverModule)
Lay_R(handoverModule, correctionModule)
Lay_R(correctionModule, lineageModule)
Lay_R(lineageModule, accessPolicy)
Lay_R(accessPolicy, evidenceModule)
Lay_R(evidenceModule, provenanceModule)
Lay_D(lineageModule, eventCore)

Lay_D(eventCore, eventRepositoryPort)
Lay_R(identityMetadataPort, ledgerPort)
Lay_R(ledgerPort, eventRepositoryPort)
Lay_R(eventRepositoryPort, eventPublisherPort)
Lay_R(eventPublisherPort, readModelPort)
Lay_R(readModelPort, artifactReferencePort)

Lay_R(postgresAdapter, ledgerAdapter)
Lay_R(ledgerAdapter, outboxAdapter)
Lay_R(outboxAdapter, artifactAdapter)

Rel(apiGateway, participantApi, "Invokes")
Rel(apiGateway, integrationApi, "Invokes")
Rel(apiGateway, queryApi, "Invokes")
Rel(apiGateway, governanceApi, "Invokes")

Rel(participantApi, eventCommit, "Depends on")
Rel(participantApi, traceQuery, "Depends on")
Rel(integrationApi, eventCommit, "Depends on")
Rel(queryApi, traceQuery, "Depends on")
Rel(governanceApi, governance, "Depends on")

Rel(eventCommit, eventCore, "Uses canonical event model")
Rel(eventCommit, handoverModule, "Uses")
Rel(eventCommit, lineageModule, "Uses")
Rel(eventCommit, evidenceModule, "Uses")
Rel(eventCommit, correctionModule, "Uses")
Rel(eventCommit, profileModule, "Uses")
Rel(eventCommit, accessPolicy, "Uses command authorisation")

Rel(traceQuery, provenanceModule, "Uses")
Rel(traceQuery, evidenceModule, "Uses")
Rel(traceQuery, accessPolicy, "Uses disclosure policy")
Rel(governance, profileModule, "Manages lifecycle")
Rel(governance, accessPolicy, "Manages policy")

Rel(handoverModule, eventCore, "Depends on")
Rel(lineageModule, eventCore, "Depends on")
Rel(evidenceModule, eventCore, "Depends on")
Rel(correctionModule, eventCore, "Depends on")
Rel(profileModule, eventCore, "Constrains")
Rel(accessPolicy, eventCore, "Evaluates")
Rel(provenanceModule, eventCore, "Interprets")

Rel(eventCommit, identityMetadataPort, "Depends on")
Rel(eventCommit, eventRepositoryPort, "Depends on")
Rel(eventCommit, ledgerPort, "Depends on")
Rel(eventCommit, eventPublisherPort, "Depends on")
Rel(eventCommit, artifactReferencePort, "Depends on")
Rel(traceQuery, identityMetadataPort, "Depends on")
Rel(traceQuery, eventRepositoryPort, "Depends on")
Rel(traceQuery, readModelPort, "Depends on")
Rel(traceQuery, ledgerPort, "Depends on")
Rel(traceQuery, artifactReferencePort, "Depends on")
Rel(governance, identityMetadataPort, "Depends on")

Rel_U(postgresAdapter, identityMetadataPort, "Implements")
Rel_U(postgresAdapter, eventRepositoryPort, "Implements")
Rel_U(postgresAdapter, readModelPort, "Implements")
Rel_U(ledgerAdapter, ledgerPort, "Implements")
Rel_U(outboxAdapter, eventPublisherPort, "Implements")
Rel_U(artifactAdapter, artifactReferencePort, "Implements")

Rel_D(postgresAdapter, traceDb, "Reads and writes logical schemas", "SQL")
Rel_D(ledgerAdapter, ledger, "Commits and verifies", "Ledger SDK/API")
Rel_D(outboxAdapter, traceDb, "Claims durable outbox records", "SQL")
Rel_D(outboxAdapter, messageBroker, "Publishes EventCommitted", "Async event")
Rel_D(artifactAdapter, artifactStore, "Resolves authorised content and verifies commitment", "Provider API")

SHOW_LEGEND()
@enduml
